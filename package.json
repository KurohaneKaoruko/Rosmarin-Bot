  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && rolldown -c",
    "typecheck": "tsc --noEmit",
    "push": "node ./scripts/submit.js",
    "push:official": "cross-env DEST=screeps.com@Kaoruko rolldown -c",
    "push:season": "cross-env DEST=screeps.com/season@Kaoruko rolldown -c",
    "push:local": "cross-env VARIANT=local DEST=local rolldown -c",
    "lint": "eslint .",
    "test": "vitest run",
    "commit": "git add . && git-cz",
    "submit": "node ./scripts/submit.js",
    "console": "node ./scripts/console.js",
    "count": "node ./scripts/countFiles.js",
    "ver": "node ./scripts/updateVersion.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=8.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/rollup-win32-x64-msvc": "4.64.1",
    "@types/lodash": "^3.10.9",
    "@types/node": "^25.9.9",
    "@types/screeps": "^3.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "git-cz": "^4.9.0",
    "git-rev-sync": "^3.0.2",
    "globals": "^15.15.0",
    "rolldown": "^1.2.12",
    "screeps-api": "^1.16.1",
    "terser": "^5.51.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
