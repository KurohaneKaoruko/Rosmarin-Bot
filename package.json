    "@inquirer/prompts": "^8.7.3",
    "inquirer": "^12.11.1",
    "shelljs": "^0.10.0",
    "source-map": "^0.6.1",
    "source-map-js": "^1.2.2",
    "ws": "^8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@screeps/driver",
      "screeps",
      "isolated-vm"
    ],
    "overrides": {
      "axios": "0.30.3",
      "esbuild": "^0.25.0",
      "axios@<=0.30.2": "0.30.3",
      "minimatch@<10.2.1": ">=10.2.1",
